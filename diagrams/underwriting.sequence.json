  "messages": [
    { "id": "get-products", "from": "client", "to": "api", "y": 185, "label": "GET /products", "variant": "emphasis", "note": "every call first passes CORS + rate-limit middleware" },
    { "id": "q-products", "from": "api", "to": "pg", "y": 223, "label": "SELECT insurance_product", "variant": "default" },
    { "id": "r-products", "from": "pg", "to": "api", "y": 261, "label": "rows", "variant": "return" },
    { "id": "res-products", "from": "api", "to": "client", "y": 299, "label": "200 products[]", "variant": "return" },

    { "id": "get-questions", "from": "client", "to": "api", "y": 344, "label": "GET /products/{code}/questions", "variant": "emphasis" },
    { "id": "q-questions", "from": "api", "to": "pg", "y": 382, "label": "JOIN product_question, uw_question", "variant": "default" },
    { "id": "r-questions", "from": "pg", "to": "api", "y": 420, "label": "rows", "variant": "return" },
    { "id": "res-questions", "from": "api", "to": "client", "y": 458, "label": "200 questions[] — no expected_answer", "variant": "return" },

    { "id": "post-quotes", "from": "client", "to": "api", "y": 503, "label": "POST /quotes {product_code}", "variant": "emphasis" },
    { "id": "q-insert-quote", "from": "api", "to": "pg", "y": 541, "label": "INSERT quote RETURNING id, access_token", "variant": "default" },
