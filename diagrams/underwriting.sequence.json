  "cards": [
    { "dot": "cyan", "title": "Read path", "items": ["GET /products and its questions never touch the pool's transactional path", "expected_answer is excluded at the query boundary, not filtered client-side"] },
    { "dot": "amber", "title": "Write path", "items": ["Both /answers and /evaluate hold one connection across BEGIN...COMMIT", "The quote_answer validation trigger runs inside that transaction — one bad answer rolls the whole batch back"] },
    { "dot": "rose", "title": "No-oracle 404", "items": ["A wrong X-Quote-Token and a nonexistent quote_id return the identical 404", "A caller can never use the response to tell which case it hit"] },
    { "dot": "orange", "title": "Trigger, computed not stored", "items": ["uw_evaluation_trigger() runs right after evaluate_and_record_quote(), same transaction, same connection", "quote_evaluation itself is untouched — the trigger only ever leaves as part of the JSON response"] }
  ]
