    { "id": "post-answers", "from": "client", "to": "api", "y": 662, "label": "POST /quotes/{id}/answers + X-Quote-Token", "variant": "emphasis" },
    { "id": "q-verify-a", "from": "api", "to": "pg", "y": 700, "label": "verify quote_id + access_token", "variant": "security" },
    { "id": "r-verify-a", "from": "pg", "to": "api", "y": 738, "label": "match", "variant": "return" },
    { "id": "q-begin-a", "from": "api", "to": "pool", "y": 776, "label": "acquire + BEGIN", "variant": "default" },
    { "id": "q-upsert", "from": "pool", "to": "pg", "y": 814, "label": "upsert answers (trigger validates answer_type)", "variant": "emphasis" },
    { "id": "r-upsert", "from": "pg", "to": "pool", "y": 852, "label": "ok", "variant": "return" },
    { "id": "r-commit-a", "from": "pool", "to": "api", "y": 890, "label": "COMMIT", "variant": "return" },
    { "id": "res-answers", "from": "api", "to": "client", "y": 928, "label": "200 {quote_id, answers[]}", "variant": "return" },

    { "id": "post-evaluate", "from": "client", "to": "api", "y": 973, "label": "POST /quotes/{id}/evaluate {strategy}", "variant": "emphasis" },
    { "id": "q-verify-e", "from": "api", "to": "pg", "y": 1011, "label": "verify quote_id + access_token", "variant": "security" },
    { "id": "r-verify-e", "from": "pg", "to": "api", "y": 1049, "label": "match", "variant": "return" },
    { "id": "q-begin-e", "from": "api", "to": "pool", "y": 1087, "label": "acquire + BEGIN", "variant": "default" },
    { "id": "q-eval-fn", "from": "pool", "to": "pg", "y": 1125, "label": "evaluate_and_record_quote(id, strategy)", "variant": "emphasis" },
    { "id": "r-eval-fn", "from": "pg", "to": "pool", "y": 1163, "label": "outcome", "variant": "return" },
    { "id": "q-trigger-fn", "from": "pool", "to": "pg", "y": 1201, "label": "uw_evaluation_trigger(id, strategy)", "variant": "default", "note": "same transaction, right after — not persisted" },
    { "id": "r-trigger-fn", "from": "pg", "to": "pool", "y": 1239, "label": "rule_id (or NULL)", "variant": "return" },
    { "id": "r-commit-e", "from": "pool", "to": "api", "y": 1277, "label": "COMMIT", "variant": "return" },
    { "id": "res-evaluate", "from": "api", "to": "client", "y": 1315, "label": "200 {outcome, evaluated_at, trigger}", "variant": "return" },

    { "id": "post-wrong-token", "from": "client", "to": "api", "y": 1369, "label": "POST /quotes/{id}/answers + wrong X-Quote-Token", "variant": "dashed" },
    { "id": "q-verify-err", "from": "api", "to": "pg", "y": 1407, "label": "verify quote_id + access_token", "variant": "security" },
    { "id": "r-verify-err", "from": "pg", "to": "api", "y": 1445, "label": "no match", "variant": "return" },
    { "id": "res-err", "from": "api", "to": "client", "y": 1483, "label": "404 Unknown quote_id", "variant": "dashed", "note": "identical message for a wrong token or a nonexistent quote_id — no oracle" }
